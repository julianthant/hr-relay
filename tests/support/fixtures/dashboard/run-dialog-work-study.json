                "rules": [
                  {
                    "when": {
                      "kind": "pattern",
                      "pattern": "eid"
                    },
                    "emit": "emplId"
                  }
                ],
                "unmatched": "Employee IDs must contain at least five digits."
              }
            },
            "display": {
              "kind": "first-present",
              "fields": [
                "emplId"
              ]
            },
            "identityFields": [
              "emplId"
            ]
          }
        ],
        "controls": [
          {
            "field": "effectiveDate",
            "label": "Effective date",
            "modes": [
              "employee-ids"
            ],
            "requires": [],
            "kind": "date",
            "placement": "input",
            "required": true,
            "refusal": "Choose a valid effective date."
