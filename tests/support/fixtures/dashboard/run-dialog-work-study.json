    "version": 1,
    "inputRun": {
      "placeholder": "Separate Employee IDs with semicolons",
      "parser": {
        "split": {
          "kind": "delimited",
          "delimiters": [
            ",",
            ";",
            "\n"
          ]
        },
        "rules": [
          {
            "when": {
              "kind": "pattern",
              "pattern": "eid"
            },
            "emit": "emplId"
          }
        ],
        "unmatched": "Employee IDs must contain at least five digits."
      },
      "typedInput": {
        "modeField": "mode",
        "modeLabel": "Input",
        "initialMode": "employee-ids",
        "description": "Each Employee ID starts one run; every run uses the one effective date.",
