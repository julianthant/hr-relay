+    }
+    assertPathMatchesDescriptor(path, afterStats);
+    return {
+      bytes,
+      identity: {
+        sha256: createHash("sha256").update(bytes).digest("hex"),
+        bytes: bytes.byteLength,
+        modifiedAtMs: beforeStats.mtimeMs,
+      },
+    };
