+  expect(geometry.right).toBeLessThanOrEqual(geometry.rowRight);
+  expect(geometry.scrollWidth).toBeLessThanOrEqual(geometry.clientWidth);
+  expect(geometry.fragments.length).toBeGreaterThan(0);
