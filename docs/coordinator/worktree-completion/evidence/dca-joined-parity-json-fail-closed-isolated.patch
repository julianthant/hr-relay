+import { spawn } from "node:child_process";
+import { createHash } from "node:crypto";
+import { lstatSync, readFileSync, realpathSync } from "node:fs";
+import { resolve } from "node:path";
+import { fileURLToPath } from "node:url";
+import { z } from "zod";
+
+export const PARITY_JSON_REPORT = "tests/parity/.output/results.json";
+
+const PARITY_JSON_ENV_OVERRIDES = [
+  "PLAYWRIGHT_JSON_OUTPUT_FILE",
+  "PLAYWRIGHT_JSON_OUTPUT_DIR",
+  "PLAYWRIGHT_JSON_OUTPUT_NAME",
+] as const;
+
+const AnnotationSchema = z.object({
+  type: z.string(),
+  description: z.string().optional(),
+  location: z.unknown().optional(),
+}).strict();
+
+const AttachmentSchema = z.object({
+  name: z.string(),
+  contentType: z.string(),
+  path: z.string().optional(),
+  body: z.string().optional(),
+}).strict();
+
+const ResultSchema = z.object({
+  workerIndex: z.number().int(),
+  parallelIndex: z.number().int(),
+  status: z.string(),
+  duration: z.number(),
+  error: z.unknown().optional(),
+  errors: z.array(z.unknown()),
+  stdout: z.array(z.unknown()),
+  stderr: z.array(z.unknown()),
+  retry: z.number().int(),
+  steps: z.array(z.unknown()).optional(),
+  startTime: z.string(),
+  annotations: z.array(AnnotationSchema),
+  attachments: z.array(AttachmentSchema),
+  errorLocation: z.unknown().optional(),
+}).strict();
+
+const TestSchema = z.object({
+  timeout: z.number(),
+  annotations: z.array(AnnotationSchema),
+  expectedStatus: z.string(),
+  projectId: z.string(),
+  projectName: z.string(),
+  results: z.array(ResultSchema),
+  status: z.string(),
+}).strict();
+
+const SpecSchema = z.object({
+  title: z.string(),
+  ok: z.boolean(),
+  tags: z.array(z.string()),
+  tests: z.array(TestSchema),
+  id: z.string(),
+  file: z.string(),
+  line: z.number().int(),
+  column: z.number().int(),
+}).strict();
+
+const SuiteSchema = z.object({
+  title: z.string(),
+  file: z.string(),
+  column: z.number().int(),
+  line: z.number().int(),
+  specs: z.array(SpecSchema),
+}).strict();
+
+const ParityReportSchema = z.object({
+  config: z.unknown(),
+  suites: z.array(SuiteSchema),
+  errors: z.array(z.unknown()),
+  stats: z.object({
+    startTime: z.string(),
+    duration: z.number(),
+    expected: z.number().int(),
+    skipped: z.number().int(),
+    unexpected: z.number().int(),
+    flaky: z.number().int(),
+  }).strict(),
+}).strict();
+
+export interface ParityReportIdentity {
+  readonly sha256: string;
+  readonly bytes: number;
+  readonly modifiedAtMs: number;
+}
+
+export interface VerifyParityJsonOptions {
+  readonly cwd: string;
+  readonly runStartedAtMs: number;
+  readonly before: ParityReportIdentity | null;
+}
+
+export interface RunParityOptions {
+  readonly cwd: string;
+  readonly env: NodeJS.ProcessEnv;
+  readonly args: readonly string[];
+  readonly command?: string;
+  readonly commandArgs?: readonly string[];
+  readonly writeError?: (message: string) => void;
+}
+
+const A11Y_DIGEST_PREFIX = "a11y-attachment-sha256:";
+
+function parityReportPath(cwd: string): string {
+  const outputRoot = resolve(cwd, "tests/parity/.output");
+  const reportPath = resolve(cwd, PARITY_JSON_REPORT);
+  if (!reportPath.startsWith(`${outputRoot}/`)) {
+    throw new Error(`parity JSON report escaped its output root: ${reportPath}`);
+  }
+  return reportPath;
+}
+
+function readReportIdentity(path: string, cwd: string): ParityReportIdentity {
+  let stats;
+  let bytes;
+  try {
+    stats = lstatSync(path);
+    const expectedRealPath = resolve(realpathSync(cwd), PARITY_JSON_REPORT);
+    if (stats.isSymbolicLink() || !stats.isFile() || realpathSync(path) !== expectedRealPath) {
+      throw new Error("report path is not one direct regular file");
+    }
+    bytes = readFileSync(path);
+  } catch (error) {
+    const message = error instanceof Error ? error.message : String(error);
+    throw new Error(`parity JSON report is missing or unreadable at ${path}: ${message}`, { cause: error });
+  }
+  return {
+    sha256: createHash("sha256").update(bytes).digest("hex"),
+    bytes: bytes.byteLength,
+    modifiedAtMs: stats.mtimeMs,
+  };
+}
+
+export function captureParityReportIdentity(cwd: string): ParityReportIdentity | null {
+  const path = parityReportPath(cwd);
+  try {
+    return readReportIdentity(path, cwd);
+  } catch (error) {
+    if (error instanceof Error && error.message.includes("ENOENT")) return null;
+    throw error;
+  }
+}
+
+function strictBase64Bytes(body: string, name: string): Buffer {
+  if (body.length === 0 || body.length % 4 !== 0 || !/^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$/u.test(body)) {
+    throw new Error(`${name} carries malformed base64 body evidence`);
+  }
+  const bytes = Buffer.from(body, "base64");
+  if (bytes.toString("base64") !== body || bytes.byteLength === 0) {
+    throw new Error(`${name} carries malformed or empty base64 body evidence`);
+  }
+  new TextDecoder("utf-8", { fatal: true }).decode(bytes);
+  return bytes;
+}
+
+function verifyResultEvidence(result: z.infer<typeof ResultSchema>, context: string): string[] {
+  const attachments = result.attachments.filter(
+    (attachment) => attachment.name.endsWith(".a11y.yml") || attachment.contentType === "text/yaml",
+  );
+  const annotations = result.annotations.filter((annotation) => annotation.type.startsWith(A11Y_DIGEST_PREFIX));
+  if (attachments.length === 0 && annotations.length === 0) return [];
+
+  const attachmentNames = new Set(attachments.map((attachment) => attachment.name));
+  const annotationNames = new Set(annotations.map((annotation) => annotation.type.slice(A11Y_DIGEST_PREFIX.length)));
+  for (const name of new Set([...attachmentNames, ...annotationNames])) {
+    const namedAttachments = attachments.filter((attachment) => attachment.name === name);
+    const namedAnnotations = annotations.filter((annotation) => annotation.type === `${A11Y_DIGEST_PREFIX}${name}`);
+    if (namedAttachments.length !== 1) {
+      throw new Error(`${context} requires exactly one a11y body attachment named ${name}; found ${namedAttachments.length}`);
+    }
+    if (namedAnnotations.length !== 1) {
+      throw new Error(`${context} requires exactly one matching sha256 annotation for ${name}; found ${namedAnnotations.length}`);
+    }
+    const attachment = namedAttachments[0];
+    const annotation = namedAnnotations[0];
+    if (attachment === undefined || annotation === undefined) throw new Error(`${context} lost ${name} during verification`);
+    if (!name.endsWith(".a11y.yml") || attachment.contentType !== "text/yaml") {
+      throw new Error(`${context} attachment ${name} must be .a11y.yml text/yaml evidence`);
+    }
+    if (attachment.path !== undefined || attachment.body === undefined) {
+      throw new Error(`${context} attachment ${name} must be body-backed and may not carry a path`);
+    }
+    if (!/^[0-9a-f]{64}$/u.test(annotation.description ?? "")) {
+      throw new Error(`${context} annotation for ${name} must carry one lowercase sha256 digest`);
+    }
+    const digest = createHash("sha256").update(strictBase64Bytes(attachment.body, name)).digest("hex");
+    if (annotation.description !== digest) {
+      throw new Error(`${context} annotation digest does not match the exact attached body for ${name}`);
+    }
+  }
+  return [...attachmentNames];
+}
+
+export function verifyParityJsonReport(options: VerifyParityJsonOptions): { readonly attachmentCount: number } {
+  const path = parityReportPath(options.cwd);
+  const identity = readReportIdentity(path, options.cwd);
+  if (options.before !== null
+      && identity.sha256 === options.before.sha256
+      && identity.bytes === options.before.bytes
+      && identity.modifiedAtMs === options.before.modifiedAtMs) {
+    throw new Error("parity JSON report is stale: the current run did not replace the prior evidence");
+  }
+  if (identity.modifiedAtMs < options.runStartedAtMs) {
+    throw new Error("parity JSON report is stale: its file timestamp predates this run");
+  }
+
+  let parsed: unknown;
+  try {
+    parsed = JSON.parse(readFileSync(path, "utf8"));
+  } catch (error) {
+    const message = error instanceof Error ? error.message : String(error);
+    throw new Error(`parity JSON report is malformed at ${path}: ${message}`, { cause: error });
+  }
+  const reportResult = ParityReportSchema.safeParse(parsed);
+  if (!reportResult.success) {
+    throw new Error(`parity JSON report is malformed at ${path}: ${reportResult.error.message}`, {
+      cause: reportResult.error,
+    });
+  }
+  const report = reportResult.data;
+  const reportStartedAtMs = Date.parse(report.stats.startTime);
+  if (!Number.isFinite(reportStartedAtMs) || reportStartedAtMs < options.runStartedAtMs) {
+    throw new Error("parity JSON report is stale: stats.startTime predates this run");
+  }
+
+  const names: string[] = [];
+  for (const suite of report.suites) {
+    for (const spec of suite.specs) {
+      for (const test of spec.tests) {
+        for (const [resultIndex, result] of test.results.entries()) {
+          names.push(...verifyResultEvidence(result, `${spec.file}:${String(spec.line)} result ${String(resultIndex)}`));
+        }
+      }
+    }
+  }
+  if (names.length === 0) throw new Error("parity JSON report carries no body-backed a11y evidence");
+  if (new Set(names).size !== names.length) {
+    throw new Error("parity JSON report repeats an a11y attachment name across results");
+  }
+  return { attachmentCount: names.length };
+}
+
+interface ChildResult {
+  readonly code: number;
+  readonly detail: string;
+}
+
+async function runChild(
+  command: string,
+  args: readonly string[],
+  cwd: string,
+  env: NodeJS.ProcessEnv,
+): Promise<ChildResult> {
+  return await new Promise((resolveChild) => {
+    const child = spawn(command, args, { cwd, env, stdio: "inherit" });
+    let spawnError: Error | undefined;
+    child.once("error", (error) => {
+      spawnError = error;
+    });
+    child.once("close", (code, signal) => {
+      if (spawnError !== undefined) {
+        resolveChild({ code: 1, detail: `could not start: ${spawnError.message}` });
+        return;
+      }
+      if (code !== null) {
+        resolveChild({ code, detail: `exit ${String(code)}` });
+        return;
+      }
+      resolveChild({ code: 1, detail: `signal ${signal ?? "unknown"}` });
+    });
+  });
+}
+
+function errorMessage(error: unknown): string {
+  return error instanceof Error ? error.message : String(error);
+}
+
+export async function runParityAndVerify(options: RunParityOptions): Promise<number> {
+  assertParityJsonOutputIsFixed(options.env, options.args);
+  const before = captureParityReportIdentity(options.cwd);
+  const runStartedAtMs = Date.now();
+  const command = options.command ?? process.execPath;
+  const commandArgs = options.commandArgs ?? [
+    fileURLToPath(new URL("../node_modules/playwright/cli.js", import.meta.url)),
+    "test",
+    "--config",
+    "playwright.parity.config.ts",
+  ];
+  const child = await runChild(command, [...commandArgs, ...options.args], options.cwd, options.env);
+
+  let verifierError: unknown;
+  try {
+    verifyParityJsonReport({ cwd: options.cwd, runStartedAtMs, before });
+  } catch (error) {
+    verifierError = error;
+  }
+
+  const writeError = options.writeError ?? ((message: string) => process.stderr.write(message));
+  if (child.code !== 0) {
+    writeError(`Playwright parity command failed first (${child.detail}).\n`);
+    if (verifierError !== undefined) {
+      writeError(`Parity JSON evidence verification also failed: ${errorMessage(verifierError)}\n`);
+    }
+    return child.code;
+  }
+  if (verifierError !== undefined) {
+    writeError(`Parity JSON evidence verification failed: ${errorMessage(verifierError)}\n`);
+    return 1;
+  }
+  return 0;
+}
+
+export function assertParityJsonOutputIsFixed(
+  env: NodeJS.ProcessEnv,
+  args: readonly string[],
+): void {
+  for (const name of PARITY_JSON_ENV_OVERRIDES) {
+    if (Object.hasOwn(env, name)) {
+      throw new Error(`${name} may not redirect parity JSON evidence`);
+    }
+  }
+  for (let index = 0; index < args.length; index += 1) {
+    const argument = args[index];
+    if (argument === "--reporter" || argument?.startsWith("--reporter=") === true) {
+      throw new Error("--reporter may not suppress the configured parity JSON reporter");
+    }
+    if (argument === "--config" || argument?.startsWith("--config=") === true
+        || argument?.startsWith("-c") === true) {
+      throw new Error("--config may not replace the parity authority configuration");
+    }
+  }
+}
+
+async function main(): Promise<void> {
+  const args = process.argv.slice(2);
+  process.exitCode = await runParityAndVerify({
+    cwd: process.cwd(),
+    env: process.env,
+    args,
+  });
+}
+
+const entryPath = process.argv[1];
+if (entryPath !== undefined && fileURLToPath(import.meta.url) === resolve(entryPath)) {
+  void main().catch((error: unknown) => {
+    const message = error instanceof Error ? error.message : String(error);
+    process.stderr.write(`Parity JSON evidence refused: ${message}\n`);
+    process.exitCode = 1;
+  });
+}
