+it("keeps each diagnostic bundle owned by one run while allowing same-run artifact sharing", async () => {
+  await withRunCaptureHttp("evidence", async server => {
+    const owners = new Map<string, string>();
+    const memberships: { runId: string; artifactId: string; origins: readonly { bundleId: string; originKind: string }[] }[] = [];
+    for (const runId of [FIXTURE_IDS.failedRun, FIXTURE_IDS.doneRun]) {
+      const response = await fetch(`${server.baseUrl}/api/v1/runs/${runId}/captures`);
+      assert.equal(response.status, 200);
+      const section = RunDetailSectionResponseSchema.parse(await response.json());
+      if (section.section !== "captures") throw new Error("Expected captures");
+      assert.equal(section.payload.runId, runId);
+      for (const capture of section.payload.artifacts) {
+        memberships.push({ runId, artifactId: capture.artifact.artifactId, origins: capture.origins });
+        for (const origin of capture.origins) {
+          const owner = owners.get(origin.bundleId);
+          if (owner !== undefined) assert.equal(owner, runId, `Diagnostic bundle ${origin.bundleId} is advertised by two different runs`);
+          owners.set(origin.bundleId, runId);
+        }
+      }
+    }
+    assert.deepEqual(memberships, [
+      { runId: FIXTURE_IDS.failedRun, artifactId: "00000000-0000-4000-8000-00000000c101", origins: [
+        { bundleId: "00000000-0000-4000-8000-00000000b101", originKind: "operator-request" },
+        { bundleId: "00000000-0000-4000-8000-00000000b102", originKind: "failure" },
+        { bundleId: "00000000-0000-4000-8000-00000000b103", originKind: "unexpected-state" },
+        { bundleId: "00000000-0000-4000-8000-00000000b104", originKind: "subject-mismatch" },
+        { bundleId: "00000000-0000-4000-8000-00000000b105", originKind: "recovery-park" },
+      ] },
+      { runId: FIXTURE_IDS.doneRun, artifactId: "00000000-0000-4000-8000-00000000c102", origins: [
+        { bundleId: "00000000-0000-4000-8000-00000000b201", originKind: "operator-request" },
+      ] },
+      { runId: FIXTURE_IDS.doneRun, artifactId: "00000000-0000-4000-8000-00000000c103", origins: [
+        { bundleId: "00000000-0000-4000-8000-00000000b201", originKind: "operator-request" },
+      ] },
+    ]);
+    assert.equal(owners.size, 6, "the two same-run artifacts share one of the six independently owned bundles");
+  });
+});
