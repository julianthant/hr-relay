+async function recordPhoneGeometry(page: Page, tile: Locator, name: string): Promise<void> {
+  const workflowPanelCount = await page.getByRole("dialog", { name: "Workflow Panel", exact: true }).count();
+  const geometry = await tile.evaluate(async node => {
+    if (!(node instanceof HTMLElement)) throw new Error("phone geometry observer lost its capture tile");
+    const rectShape = (rect: DOMRect) => ({ bottom: rect.bottom, height: rect.height, left: rect.left,
+      right: rect.right, top: rect.top, width: rect.width });
+    const controls = [...node.querySelectorAll("button, a[href]")].flatMap(control => {
+      if (!(control instanceof HTMLElement)) return [];
+      const rect = control.getBoundingClientRect();
+      const target = { bottom: rect.top + rect.height / 2 + 22, left: rect.left + rect.width / 2 - 22,
+        right: rect.left + rect.width / 2 + 22, top: rect.top + rect.height / 2 - 22 };
+      return [{ actual: rectShape(rect), effective44: target,
+        failedEdges: [target.left < 0 ? "left" : null, target.right > innerWidth ? "right" : null,
+          target.top < 0 ? "top" : null, target.bottom > innerHeight ? "bottom" : null].filter(Boolean),
+        name: control.getAttribute("aria-label") ?? control.textContent?.trim() ?? "unnamed" }];
+    });
+    const ancestors: Array<Record<string, unknown>> = [];
+    for (let current: HTMLElement | null = node; current !== null; current = current.parentElement) {
+      const style = getComputedStyle(current);
+      ancestors.push({ className: current.className, clientHeight: current.clientHeight, clientWidth: current.clientWidth,
+        id: current.id, overflowX: style.overflowX, overflowY: style.overflowY, rect: rectShape(current.getBoundingClientRect()),
+        role: current.getAttribute("role"), scrollHeight: current.scrollHeight, scrollLeft: current.scrollLeft,
+        scrollTop: current.scrollTop, scrollWidth: current.scrollWidth, tagName: current.tagName, transform: style.transform });
+    }
+    const intersection = await new Promise<Readonly<{ boundingClientRect: ReturnType<typeof rectShape>;
+      intersectionRatio: number; intersectionRect: ReturnType<typeof rectShape>; isIntersecting: boolean }>>(resolve => {
+      const observer = new IntersectionObserver(entries => {
+        const entry = entries[0];
+        observer.disconnect();
+        if (entry === undefined) throw new Error("phone geometry observer received no intersection entry");
+        resolve({ boundingClientRect: rectShape(entry.boundingClientRect), intersectionRatio: entry.intersectionRatio,
+          intersectionRect: rectShape(entry.intersectionRect), isIntersecting: entry.isIntersecting });
+      });
+      observer.observe(node);
+    });
+    return { ancestors, controls, devicePixelRatio, documentScroll: { x: scrollX, y: scrollY }, intersection,
+      tile: rectShape(node.getBoundingClientRect()), viewport: { height: innerHeight, width: innerWidth } };
+  });
+  const jsonPath = test.info().outputPath(`${name}.json`);
+  await writeFile(jsonPath, `${JSON.stringify({ ...geometry, workflowPanelCount }, null, 2)}\n`, "utf8");
+  await test.info().attach(`${name}.json`, { path: jsonPath, contentType: "application/json" });
+  const pngPath = test.info().outputPath(`${name}.png`);
+  await page.screenshot({ path: pngPath, fullPage: false, animations: "disabled" });
+  await test.info().attach(`${name}.png`, { path: pngPath, contentType: "image/png" });
+}
