export interface DryRunScenarioComposeInput {
  readonly isolation: RuntimeIsolation;
  readonly args: readonly string[];
  readonly loadManifest: (workflow: string) => Promise<unknown>;
  readonly createRuntime: (input: Readonly<{
    isolation: RuntimeIsolation;
    repoRoot: string;
    env: NodeJS.ProcessEnv;
    clock: Clock;
    ids: IdFactory;
  }>) => DryRunScenarioRuntime;
  readonly repoRoot?: string;
  readonly env?: NodeJS.ProcessEnv;
  readonly clock?: Clock;
  readonly ids?: IdFactory;
}

export async function composeDryRunScenarioCommand(
  input: DryRunScenarioComposeInput,
      persistResult: (result) => {
        database.authority.dryRunScenarioResults.insert(result);
      },
      createRuntime: () => input.createRuntime({
        isolation: input.isolation,
        repoRoot,
        env,
        clock,
        ids,
      }),
      clock,
  });
  const emitter = createSpanJsonlWriter({ stateRoot, clock });
  // D267 (ref execution-and-sessions §10): the per-credential Duo ceremony
  // lease, keyed on the credential identity resolved ONCE here — an
  // unresolvable identity refuses the whole worker at boot.
  const duoCeremony = input.duoCeremony ?? composeDuoCeremonyGateFactory({
    config: resolved.config,
    leases: database.authority.duoCeremonyLeases,
    clock,
    scheduler,
  });

