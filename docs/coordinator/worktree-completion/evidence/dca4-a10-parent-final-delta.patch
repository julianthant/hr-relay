+function captureCorrupt(runId: string, message: string, cause?: unknown): never {
+  throw new DiagnosticBundleCorruptError(
+    `run ${runId} diagnostic captures are corrupt: ${message}`,
+    ...(cause === undefined ? [] : [{ cause }]),
