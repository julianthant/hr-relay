{
  "name": "hr-relay",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "cli": "tsx scripts/dev/secure-env-bootstrap.ts cli",
    "dashboard": "tsx scripts/dev/dashboard.ts",
    "dashboard:prod": "tsx scripts/dev/secure-env-bootstrap.ts cli dashboard --prod",
    "web": "vite --config vite.dashboard.config.ts",
    "web:build": "vite build --config vite.dashboard.config.ts",
    "web:preview": "vite preview --config vite.dashboard.config.ts",
    "build:manifest": "tsx scripts/build/generate-workflow-manifest.ts",
    "build:manifest:check": "tsx scripts/build/generate-workflow-manifest.ts --check",
    "stores:catalog": "tsx scripts/docs/generate-store-catalog.ts",
    "stores:catalog:check": "tsx scripts/docs/generate-store-catalog.ts --check",
    "roadmap": "tsx scripts/docs/roadmap.ts",
    "roadmap:check": "tsx scripts/docs/roadmap.ts --check",
    "smoke:test-target-document-number": "tsx scripts/dev/secure-env-bootstrap.ts test-target-document-number",
    "typecheck": "tsc --noEmit",
    "privacy:check": "tsx scripts/verify/privacy.ts",
    "lint": "eslint src tests scripts vitest.config.ts vite.dashboard.config.ts vite.parity.config.ts --max-warnings 0",
    "test": "tsx scripts/test/runner.ts run",
    "test:unit": "tsx scripts/test/runner.ts unit",
    "test:integration": "tsx scripts/test/runner.ts integration",
    "test:architecture": "tsx scripts/test/runner.ts run --project architecture --passWithNoTests=false",
    "test:coverage": "tsx scripts/test/runner.ts run --coverage --project unit --project integration --project architecture && tsx scripts/test/suite-size.ts",
    "test:perf": "tsx scripts/test/runner.ts run --project perf --passWithNoTests=false",
    "test:watch": "vitest",
    "perf:dashboard": "TZ=UTC tsx tests/perf/dashboard-benchmark.ts",
    "test:reap": "tsx scripts/test/runner.ts --reap",
    "test:parity": "tsx scripts/verify-parity-json.ts assert",
    "test:parity:update": "tsx scripts/verify-parity-json.ts update"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.61.1",
    "@tailwindcss/vite": "4.2.2",
    "@types/node": "26.1.2",
    "@types/pngjs": "^6.0.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "@vitejs/plugin-react": "6.1.0",
    "@vitest/coverage-v8": "~4.1.11",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.7.0",
    "jsdom": "^30.0.1",
    "tailwindcss": "4.2.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.2",
    "vite": "8.2.2",
    "vitest": "~4.1.11"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@heroui/react": "^3.2.6",
    "@heroui/styles": "^3.2.6",
    "@internationalized/date": "^3.12.4",
    "@napi-rs/keyring": "2.1.0",
    "@radix-ui/react-checkbox": "1.3.3",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-context-menu": "2.3.1",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-popover": "1.1.15",
    "@radix-ui/react-slot": "1.3.0",
    "@radix-ui/react-tabs": "1.1.21",
    "@radix-ui/react-tooltip": "1.2.8",
    "@radix-ui/react-visually-hidden": "^1.2.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "csv-parse": "^7.0.2",
    "exceljs": "4.4.0",
    "hono": "^4.13.13",
    "jszip": "3.10.2",
    "lucide-react": "1.8.0",
    "pdf-to-img": "^7.0.0",
    "playwright": "^1.61.1",
    "pngjs": "^5.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "read-excel-file": "^9.3.5",
    "saxes": "6.0.0",
    "tailwind-merge": "3.5.0",
    "write-excel-file": "^4.1.1",
    "zod": "^4.3.6"
  }
}
