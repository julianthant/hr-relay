{
  "name": "hr-relay",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "cli": "tsx scripts/dev/secure-env-bootstrap.ts cli",
    "dashboard": "tsx scripts/dev/dashboard.ts",
    "backend": "tsx scripts/dev/dashboard.ts --backend-only",
    "dashboard:prod": "tsx scripts/dev/secure-env-bootstrap.ts cli dashboard --prod",
    "web": "tsx scripts/dev/dashboard.ts --web-only",
    "web:build": "vite build --config vite.dashboard.config.ts",
    "web:preview": "vite preview --config vite.dashboard.config.ts",
    "roadmap": "tsx scripts/docs/roadmap.ts",
    "roadmap:check": "tsx scripts/docs/roadmap.ts --check",
    "smoke:test-target-document-number": "tsx scripts/dev/secure-env-bootstrap.ts test-target-document-number",
    "typecheck": "tsc --noEmit",
    "names:check": "node scripts/ci/names-check.ts",
    "privacy:check": "tsx scripts/verify/privacy.ts",
    "verify:prelogin": "tsx scripts/verify/prelogin-rehearsal.ts",
    "lint": "node --max-old-space-size=6144 node_modules/eslint/bin/eslint.js --cache --cache-strategy content --cache-location node_modules/.cache/eslint/ src tests scripts vitest.config.ts vite.dashboard.config.ts vite.mocks.config.ts --max-warnings 0",
    "test": "vitest run --project unit --project integration --project architecture --project perf",
    "test:unit": "vitest run --project unit --passWithNoTests=false",
    "test:integration": "vitest run --project integration --passWithNoTests=false",
    "test:architecture": "vitest run --project architecture --passWithNoTests=false",
    "test:coverage": "vitest run --coverage --project unit --project integration --project architecture",
    "test:perf": "vitest run --project perf --passWithNoTests=false",
    "test:local": "vitest run --project local --passWithNoTests=true",
    "test:pc": "tsx scripts/test/pc.ts",
    "test:watch": "vitest --project unit --project integration --project architecture --project perf",
    "perf:dashboard": "TZ=UTC tsx tests/perf/dashboard-benchmark.ts",
    "mocks": "playwright test --config playwright.mocks.config.ts",
    "build:observer-policy": "tsx scripts/build/windows-observer-policy.ts",
    "precli": "npm run build:observer-policy",
    "predashboard": "npm run build:observer-policy",
    "prebackend": "npm run build:observer-policy",
    "predashboard:prod": "npm run build:observer-policy",
    "presmoke:test-target-document-number": "npm run build:observer-policy",
    "preperf:dashboard": "npm run build:observer-policy"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.1.2",
    "@types/pngjs": "^6.0.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "@vitejs/plugin-react": "6.1.0",
    "@vitest/coverage-v8": "~4.1.12",
    "esbuild": "0.28.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.7.0",
    "jsdom": "^30.0.1",
    "tailwindcss": "4.3.5",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.2",
    "vite": "8.2.4",
    "vitest": "~4.1.12"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@cantoo/pdf-lib": "2.11.1",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@heroui/react": "^3.2.7",
    "@heroui/styles": "^3.2.7",
    "@hono/node-server": "^2.1.8",
    "@internationalized/date": "^3.12.4",
    "@napi-rs/keyring": "2.1.2",
    "@radix-ui/react-checkbox": "1.4.1",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-context-menu": "2.4.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@radix-ui/react-visually-hidden": "^1.2.13",
    "@shbernal/ts-xlsx": "4.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "csv-parse": "^7.0.3",
    "hono": "^4.13.16",
    "jszip": "3.10.2",
    "koffi": "3.3.8",
    "lucide-react": "1.72.0",
    "pdf-to-img": "^7.0.2",
    "playwright": "^1.65.0",
    "pngjs": "^7.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "read-excel-file": "^9.3.15",
    "saxes": "6.0.0",
    "tailwind-merge": "3.7.0",
    "write-excel-file": "^4.1.1",
    "zod": "^4.6.7"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "fsevents@2.3.2": true,
    "koffi": false
  },
  "overrides": {
    "jsdom": {
      "undici": "8.12.2"
    },
    "minimatch@^10.0.0": "11.0.1"
  }
}
