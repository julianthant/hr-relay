{
  "name": "hr-automation-rebuild",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "cli": "tsx --env-file=.env src/cli.ts",
    "dashboard": "tsx scripts/dev-dashboard.ts",
    "dashboard:prod": "tsx --env-file=.env src/cli.ts dashboard --prod",
    "web": "vite --config vite.dashboard.config.ts",
    "web:build": "vite build --config vite.dashboard.config.ts",
    "web:preview": "vite preview --config vite.dashboard.config.ts",
    "test:parity": "playwright test --config playwright.parity.config.ts",
    "test:parity:update": "PARITY_UPDATE=1 playwright test --config playwright.parity.config.ts",
    "build:manifest": "tsx scripts/generate-build-manifest.ts",
    "build:manifest:check": "tsx scripts/generate-build-manifest.ts --check",
    "roadmap": "tsx scripts/generate-roadmap.ts",
    "roadmap:check": "tsx scripts/generate-roadmap.ts --check",
    "ui:catalog": "tsx scripts/generate-ui-catalog.ts",
    "selector:search": "tsx scripts/search-ui.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests scripts --max-warnings 0",
    "test": "vitest run --reporter=dot",
    "test:architecture": "vitest run tests/unit/architecture --reporter=dot",
    "test:coverage": "vitest run --coverage --reporter=dot && tsx scripts/suite-size.ts",
    "test:watch": "vitest",
    "perf:dashboard": "TZ=UTC tsx tests/perf/dashboard-benchmark.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.61.1",
    "@tailwindcss/vite": "4.2.2",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "@vitejs/plugin-react": "6.1.0",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.7.0",
    "jsdom": "^30.0.1",
    "tailwindcss": "4.2.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.2",
    "vite": "8.2.2",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@radix-ui/react-checkbox": "1.3.3",
    "@radix-ui/react-context-menu": "2.3.1",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-popover": "1.1.15",
    "@radix-ui/react-tooltip": "1.2.8",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "csv-parse": "^7.0.2",
    "hono": "^4.12.34",
    "lucide-react": "1.8.0",
    "pdf-to-img": "^6.2.0",
    "playwright": "^1.61.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "read-excel-file": "^9.3.5",
    "tailwind-merge": "3.5.0",
    "write-excel-file": "^4.1.1",
    "zod": "^4.3.6"
  }
}
