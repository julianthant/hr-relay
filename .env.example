# HR Automation rebuild local setup. Create the ignored `.env` with owner-only
# permissions before filling only the values required for local verification:
#
#   umask 077
#   install -m 600 .env.example .env
#
# Never commit `.env`. Runtime and secret-smoke startup refuse a missing,
# non-regular, oversized, or group/other-readable copy.
#
# `npm run dashboard` starts the rebuild BFF on http://localhost:3938 and the
# dashboard on http://localhost:5174. `npm run cli -- <command>` runs the rebuild
# CLI. Settings are resolved once as env > config/settings.json > default.

UCPATH_USER_ID=
UCPATH_PASSWORD=

# Optional operator default used where a workflow declares it. Keep it local.
TIMEKEEPER_NAME=

# Current 4537 finalization canary person values are direct identifiers. Keep
# them only in ignored `.env`; the committed registry carries only these public
# reference keys. Populate all three before the no-output smoke, then run:
# npm run smoke:test-target-person-secrets
HRAUTO_TEST_SUBJECT_SEPARATIONS_KUALI_FINALIZATION_CANARY_EID=
HRAUTO_TEST_SUBJECT_SEPARATIONS_KUALI_FINALIZATION_CANARY_EMPLOYEE_NAME=
HRAUTO_TEST_SUBJECT_SEPARATIONS_KUALI_FINALIZATION_CANARY_TIMEKEEPER_NAME=

# Other supported rebuild configuration keys. Leave these commented to use the
# resolver defaults; uncomment only when deliberately overriding local setup.
# ANNUAL_DATES_END=06/30/2027
# KRONOS_DEFAULT_END_DATE=2/1/2027
# KRONOS_DEFAULT_START_DATE=1/1/2017
# ONBOARDING_ROSTER_URL=https://ucsdcloud.sharepoint.com/.../onboarding.xlsx
# HR_AUTOMATION_DUO_WEBAUTHN=1

# Retired legacy capture aliases. The rebuild does not read these keys; keep
# them unset. They remain listed only so old local files are unambiguous.
# CAPTURE_PUBLIC_URL=
# CAPTURE_NGROK_URL=

# DEBUG_SCREENSHOTS=1
# HRAUTO_UKG_NAVIGATION_MS=60000
# HRAUTO_NAVIGATION_RETRIES=10
# HRAUTO_SEPARATION_TERMINATION_WINDOW_DAYS=14
# OCR_SECOND_OPINION_MAX=5
# OCR_PAGE_MAX_WAIT_MS=120000
# OCR_PAGE_CONCURRENCY=
# OCR_DISAMBIG_CONCURRENCY=4
# OCR_SUGGEST_CONCURRENCY=4
