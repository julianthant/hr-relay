# HR Automation rebuild provider-key setup. Create the ignored `.env` with
# owner-only permissions before filling only provider API-key pool cells:
#
#   umask 077
#   install -m 600 .env.example .env
#
# Never commit `.env`. Runtime startup refuses a missing, non-regular,
# oversized, or group/other-readable copy. All ordinary and protected settings
# belong in Settings; their former environment names are refused at startup.
#
# Pool cells 2 through 8 use the same prefix with a numeric suffix, for example
# GEMINI_API_KEY2. No other names are admitted.
GEMINI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
OPEN_ROUTER_API_KEY=
SAMBANOVA_API_KEY=
