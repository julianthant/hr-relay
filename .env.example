# Most of the values below can ALSO be set from the dashboard Settings page
# (navbar gear), which writes config/settings.json (gitignored). Precedence is
# env var > config/settings.json > built-in default, so anything set here always
# wins over the Settings page.

# This rebuild uses .tracker-rebuild for state, .tracker-rebuild/artifacts for
# artifacts, and .tracker-rebuild/locks for process locks. `npm run dashboard`
# starts the BFF on 127.0.0.1:3938 and Vite on 127.0.0.1:5174. The BFF alone
# is `npm run cli -- dashboard`; the frontend alone is `npm run web`.

UCPATH_USER_ID=your-ucsd-user-id
UCPATH_PASSWORD=your-ucsd-password

# I-9 Complete needs NO separate credentials — since 2026-07-01 it authenticates
# through the UCOP portal via UCSD campus SSO + Duo (the same UCPATH_USER_ID /
# UCPATH_PASSWORD as every other UCSD system). The old standalone I9_USER_ID /
# I9_PASSWORD vendor login (stse.i9complete.com) was retired with that change.

TIMEKEEPER_NAME=your-timekeeper-name

# Live dry-run subject EIDs and display names are direct identifiers. Keep the
# values only in the ignored .env; config/test-subjects.json commits these key
# names and known non-sensitive canonical-input fields, never person values.
# HRAUTO_TEST_SUBJECT_SEPARATIONS_KUALI_FINALIZATION_CANARY_EID=
# HRAUTO_TEST_SUBJECT_SEPARATIONS_KUALI_FINALIZATION_CANARY_EMPLOYEE_NAME=
# HRAUTO_TEST_SUBJECT_SEPARATIONS_KUALI_FINALIZATION_CANARY_TIMEKEEPER_NAME=

# Annual dates (optional — override when fiscal year rolls)
# Format matches the strict resolver in src/domain/config/resolve.ts (MM/DD/YYYY or M/D/YYYY).
# ANNUAL_DATES_END=06/30/2027
# KRONOS_DEFAULT_END_DATE=2/1/2027
# KRONOS_DEFAULT_START_DATE=1/1/2017

# SharePoint roster URL (consumed by the migrated SharePoint workflow when it
# is enabled). The closed secret registry and config resolver own this key;
# unset values are refused at the workflow boundary.
#
# ONBOARDING_ROSTER_URL=https://ucsdcloud.sharepoint.com/.../onboarding.xlsx

# Hands-off Duo MFA via a WebAuthn virtual authenticator (Chromium only).
#
# When set to 1, login flows approve Duo automatically using a credential
# enrolled once as an independent Duo security key — no phone push. Enroll the
# credential in the gitignored `.auth/duo-webauthn.json`, then set this flag.
# The browser session factory loads the unpacked `duo-autopilot/` extension.
# Any failure (missing credential, factor not offered, ceremony rejected) is
# surfaced; it does not silently turn into a successful login. Unset (or any
# value other than 1) disables it. See src/infra/browser/browser-session-factory.ts.
#
# HR_AUTOMATION_DUO_WEBAUTHN=1

# Mobile-photo capture is not configured by this rebuild `.env` file. The
# retired CAPTURE_PUBLIC_URL / CAPTURE_NGROK_URL examples belonged to the
# legacy launcher; `npm run dashboard` does not start ngrok and the rebuild
# dashboard binds only to its own loopback BFF/frontend ports above.
# Keep these blank compatibility keys for the environment inventory; the
# rebuild does not read them.
# CAPTURE_PUBLIC_URL=
# CAPTURE_NGROK_URL=

# Debug screenshot capture (default OFF).
# Set to 1 to enable debug screenshots in browser hot paths. Off by default;
# operator-audit screenshots remain governed by their own evidence contract.
#
# DEBUG_SCREENSHOTS=1

# Performance / OCR tuning — normally set from the dashboard Settings page, but
# overridable here (env wins). Defaults shown.
# HRAUTO_UKG_NAVIGATION_MS=60000                 # UKG/Kronos page-navigation timeout (ms)
# HRAUTO_NAVIGATION_RETRIES=10                    # nav refresh attempts before failing a run
# HRAUTO_SEPARATION_TERMINATION_WINDOW_DAYS=14    # prior-TER reuse window (days)
# OCR_SECOND_OPINION_MAX=5
# OCR_PAGE_MAX_WAIT_MS=120000
# OCR_PAGE_CONCURRENCY=                            # blank = Auto (vision-pool size)
# OCR_DISAMBIG_CONCURRENCY=4
# OCR_SUGGEST_CONCURRENCY=4
