# Environment variables / secrets
.env
.env.*
!.env.example

# Private test inputs (D341): live subject values and private document paths.
# The tracked example carries placeholders only.
config/test-data.local.json
# Staging file of an interrupted private write (same directory, mode 0600).
config/.test-data.local.*.tmp

# Node
node_modules/

# IDE
.vscode/
.idea/

# Auth session state
.auth-rebuild/

# Claude Code
.claude/settings.local.json
.design/

# Playwright CLI
.playwright-cli/
.playwright/

# Duo Autopilot extension — NEVER commit the enrolled WebAuthn private keys
duo-autopilot/credentials/
duo-autopilot/node_modules/

# Rebuild runtime state + artifacts (isolated roots, see config/runtime-isolation.json)
.tracker/
.runtime-control/

# Coverage lane output (`npm run test:coverage`) — regenerated every run.
coverage/

# Generated runner metadata; failure diagnostics remain in the owned /tmp run root.
test-results/

# Built frontend bundle (`npm run web:build`) — regenerated,
# and the parity lane rebuilds it before capturing.
dist/

# Playwright parity lane scratch: failure screenshots, traces, diff images.
# The REFERENCE set under tests/parity/references/ is committed on purpose —
# that is the evidence; this is only what a failing run left behind.
tests/parity/.output/

# Live-probe screenshots and accessibility dumps. A probe against UCPath /
# Kuali / CRM captures REAL names, EIDs, and transaction numbers, so these are
# restricted HR data and must never enter git. The committed evidence for a
# probe is its sanitized manifest under docs/rebuild/evidence/selectors/**, which records that a
# recipe matched exactly once and deliberately carries `capturedValue: false`.
.screenshots/

# OS
.DS_Store
Thumbs.db

# Operator data files dropped into the repo root for a one-off parse.
# Real HR records — never committed.
OnboardingRoster-*.xlsx
*.xlsx
!tests/**/fixtures/**/*.xlsx
.auth/
