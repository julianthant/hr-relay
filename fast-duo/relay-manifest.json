{
  "manifest_version": 3,
  "name": "Relay Duo setup",
  "version": "0.3.0",
  "permissions": ["storage"],
  "host_permissions": ["https://*.duosecurity.com/*"],
  "background": { "service_worker": "src/relay-background.js", "type": "module" },
  "content_scripts": [
    { "matches": ["https://*.duosecurity.com/*"], "js": ["src/relay-inpage.js"], "run_at": "document_start", "world": "MAIN" },
    { "matches": ["https://*.duosecurity.com/*"], "js": ["src/username.js", "src/relay-content.js"], "run_at": "document_start", "world": "ISOLATED" }
  ],
  "minimum_chrome_version": "140"
}
