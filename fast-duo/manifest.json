{
  "manifest_version": 3,
  "name": "Duo Autopilot",
  "version": "0.3.0",
  "description": "A local software WebAuthn authenticator for your own Duo account.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://*.duosecurity.com/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "options_page": "src/options.html",
  "content_scripts": [
    {
      "matches": [
        "https://*.duosecurity.com/*"
      ],
      "js": [
        "src/inpage.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "https://*.duosecurity.com/*"
      ],
      "js": [
        "src/username.js",
        "src/content.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED",
      "all_frames": true
    }
  ],
  "minimum_chrome_version": "140",
  "action": {
    "default_title": "Duo Autopilot",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "src/icons/autopilot-16.png",
      "32": "src/icons/autopilot-32.png",
      "48": "src/icons/autopilot-48.png",
      "128": "src/icons/autopilot-128.png"
    }
  },
  "icons": {
    "16": "src/icons/autopilot-16.png",
    "32": "src/icons/autopilot-32.png",
    "48": "src/icons/autopilot-48.png",
    "128": "src/icons/autopilot-128.png"
  }
}
