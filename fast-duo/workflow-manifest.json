{
  "manifest_version": 3,
  "name": "Relay Duo login",
  "version": "0.3.0",
  "permissions": ["tabs", "webNavigation"],
  "host_permissions": ["https://*.duosecurity.com/*"],
  "background": { "service_worker": "src/workflow-background.js", "type": "module" },
  "content_scripts": [
    { "matches": ["https://*.duosecurity.com/*"], "js": ["src/workflow-inpage.js"], "run_at": "document_start", "world": "MAIN", "all_frames": true },
    { "matches": ["https://*.duosecurity.com/*"], "js": ["src/username.js", "src/workflow-content.js"], "run_at": "document_start", "world": "ISOLATED", "all_frames": true }
  ],
  "minimum_chrome_version": "140"
}
